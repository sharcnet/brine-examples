# Copy to .env or export these variables in your shell.
# Use the base URL you were given for SHARCNET Brine's OpenAI-compatible API.
BRINE_BASE_URL="https://brine.example.org/v1"
BRINE_API_KEY="paste-your-access-key-here"

# Optional: override the Gemma model used by the examples.
BRINE_MODEL="gemma-4-31B-it"
